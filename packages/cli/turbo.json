{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "package.json",
        "../../.env.example",
        "../../ouija.config.example.yaml",
        "../../infra/setup.sh",
        "../../docker/**"
      ],
      "outputs": ["dist/**", "assets/**"]
    }
  }
}
