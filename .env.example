# =============================================================================
# Ouija environment configuration
# =============================================================================
# Copy this file to `.env` (or run `bash infra/setup.sh` to auto-generate
# secrets and copy it for you). Everything commented out is optional.
#
# Rule of thumb:
#   - Secrets: generate with `openssl rand -hex 32` (never commit)
#   - API tokens: scope narrowly, rotate often
#   - When in doubt, leave blank — most plugins gracefully no-op when unset
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------

# Cryptographic secret used to sign agent callback JWTs. MUST be 32+ chars.
# Generate: openssl rand -hex 32
OUIJA_SECRET_KEY=

# Postgres connection string. The docker-compose files inject this
# automatically — override here only for local dev or external Postgres.
OUIJA_DATABASE_URL=postgres://ouija:ouija@localhost:5432/ouija_db

# Redis connection string. BullMQ uses this for job queues and rate limits.
OUIJA_REDIS_URL=redis://localhost:6379

# Public URL where Ouija is reachable. Agents use this to POST heartbeats
# and your kanban plugin uses it to register webhook endpoints.
# In Docker the default works; for Tailscale Funnel / ngrok, set the public URL.
OUIJA_SERVER_URL=http://localhost:4000

# HTTP server port (default: 4000).
# PORT=4000

# Structured logging level: error | warn | info | debug | trace
LOG_LEVEL=info

# Number of concurrent agent dispatches per worker process (default: 1).
# Increase only if your agents are I/O-bound and you have headroom.
OUIJA_WORKER_CONCURRENCY=1

# Disable the in-process agent worker (set to 1 when running the worker as
# a separate process, e.g. for horizontal scaling).
# OUIJA_DISABLE_AGENT_WORKER=0

# Absolute path to ouija.config.yaml. Defaults to ./ouija.config.yaml.
# OUIJA_CONFIG_PATH=/app/ouija.config.yaml

# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
# CORS_ORIGIN=https://my-dashboard.example.com

# Optional static API key for admin endpoints. If unset, JWT auth is required.
# OUIJA_API_KEY=

# -----------------------------------------------------------------------------
# Claude agent auth (choose ONE method)
# -----------------------------------------------------------------------------

# Method 1 — Direct Anthropic API key (simplest)
ANTHROPIC_API_KEY=

# Method 2+ — Bedrock, Vertex, Foundry, or Proxy are configured per-agent in
# ouija.config.yaml. Any env vars those methods need (AWS_*, GOOGLE_*, etc.)
# should be set here the same way you'd set them for the respective SDK.

# Claude model to dispatch to. Override per-agent in ouija.config.yaml.
CLAUDE_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# GitHub (for the agent to clone repos, push branches, and open PRs)
# -----------------------------------------------------------------------------

# Personal access token or GitHub App installation token. Needs:
#   - repo (read/write for private repos; public_repo for public)
#   - workflow (if the agent touches .github/workflows)
GITHUB_PAT=

# HMAC secret for inbound GitHub webhooks (push/PR events). Optional.
# GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Plane kanban backend (use this OR Fizzy, not both)
# -----------------------------------------------------------------------------

# Base URL of your Plane instance. For Plane Cloud: https://api.plane.so
# For self-hosted in docker-compose.yml: http://plane-aio:80
PLANE_BASE_URL=https://api.plane.so

# API token generated from Plane → Settings → API Tokens
PLANE_API_TOKEN=

# Slug of the Plane workspace Ouija should manage
PLANE_WORKSPACE_SLUG=

# HMAC secret registered with Plane's webhook. Generated by infra/setup.sh.
PLANE_WEBHOOK_SECRET=

# Plane server secret (only used by the full-stack compose that hosts Plane).
# Generated by infra/setup.sh.
# PLANE_SECRET_KEY=

# Public URL of the Plane web UI (used by the full-stack compose).
# PLANE_WEB_URL=http://localhost:80

# -----------------------------------------------------------------------------
# Fizzy kanban backend (alternative to Plane)
# -----------------------------------------------------------------------------

# Base URL of your Fizzy instance
# FIZZY_BASE_URL=http://fizzy.local:3000

# API access token
# FIZZY_ACCESS_TOKEN=

# HMAC secret for inbound Fizzy webhooks
# FIZZY_WEBHOOK_SECRET=

# Fizzy server secret (only needed by the docker-compose.fizzy.yml full stack)
# FIZZY_SECRET_KEY=

# -----------------------------------------------------------------------------
# Telegram notifications (optional)
# -----------------------------------------------------------------------------

# BotFather token. Leave blank to disable Telegram notifications.
# TELEGRAM_BOT_TOKEN=

# Chat ID or channel username to post to (e.g. -1001234567890 or @mychannel)
# TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Defaults used by the hardcoded fallback agent profile (legacy, pre-config)
# These are ignored if ouija.config.yaml defines at least one agent.
# -----------------------------------------------------------------------------

# DEFAULT_REPO_URL=https://github.com/your-org/your-repo.git
# DEFAULT_BASE_BRANCH=main
